{
  "name": "applet",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "ng serve",
    "db:setup": "tsx server/db/init.ts",
    "db:migrate": "tsx server/migrate.ts",
    "setup-cars": "tsx server/setup-cars-1-to-30.ts",
    "wipe-transactions": "tsx server/wipe-transactions.ts",
    "server": "tsx server/server.ts",
    "dev:server": "tsx watch server/server.ts",
    "build": "ng build",
    "publish": "powershell -ExecutionPolicy Bypass -File ./package-iis.ps1",
    "package:iis": "powershell -ExecutionPolicy Bypass -File ./package-iis.ps1",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@napi-rs/canvas": "^1.0.8",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/vite": "^4.3.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.1.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "nodemailer": "^10.1.0",
    "pg": "^8.22.0",
    "postcss": "^8.5.19",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.2",
    "tslib": "^2.3.0",
    "tsx": "^4.23.12",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@angular/build": "^22.0.6",
    "@angular/cli": "^22.0.6",
    "@angular/compiler-cli": "^22.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
