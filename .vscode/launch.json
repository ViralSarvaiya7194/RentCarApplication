{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Backend API Server",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm.cmd run dev:server"
        },
        {
            "name": "Frontend Angular Server",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm.cmd run dev"
        },
        {
            "name": "Launch Chrome - Rental Car",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:4200",
            "webRoot": "${workspaceFolder}"
        }
    ]
}